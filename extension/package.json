{
  "name": "extension",
  "displayName": "Nih — Tip MUSD anywhere",
  "version": "0.4.0",
  "description": "Tip Bitcoin-backed MUSD on Twitter, YouTube, Substack, GitHub. Powered by Mezo.",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.11.0",
    "lucide-react": "^0.453.0",
    "plasmo": "^0.88.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.0"
  },
  "manifest": {
    "host_permissions": [
      "https://twitter.com/*",
      "https://x.com/*",
      "https://www.youtube.com/*",
      "https://*.substack.com/*",
      "https://medium.com/*",
      "https://*.medium.com/*",
      "https://github.com/*",
      "https://www.reddit.com/*",
      "https://old.reddit.com/*",
      "https://news.ycombinator.com/*",
      "https://www.twitch.tv/*",
      "https://www.linkedin.com/in/*",
      "https://rpc.test.mezo.org/*",
      "https://mainnet.mezo.public.validationcloud.io/*"
    ],
    "permissions": ["storage", "activeTab"]
  }
}
